# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Telegram bot token — used to verify the signature of WebApp initData
BOT_TOKEN=<telegram-bot-token>

# AES-256-GCM key for encrypting user content at rest.
# Must be 32 bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: losing or changing this key makes existing encrypted data unreadable.
ENCRYPTION_KEY=<64-hex-characters>

# Optional
PORT=3001
CORS_ORIGINS=https://tododo-web-app.vercel.app,http://localhost:3000
